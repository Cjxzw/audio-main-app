<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchContextAsset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/tvContextAssetTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:paddingEnd="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/btnEditContextAsset"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/context_asset_edit"
        android:padding="12dp"
        android:src="@drawable/ic_edit_24" />

    <ImageButton
        android:id="@+id/btnDeleteContextAsset"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/context_asset_delete"
        android:padding="12dp"
        android:src="@drawable/ic_delete_24" />
</LinearLayout>
